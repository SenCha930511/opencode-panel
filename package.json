{
  "name": "opencode-panel",
  "displayName": "OpenCode Panel",
  "description": "Sidebar chat panel for your locally installed opencode",
  "version": "0.8.10",
  "publisher": "SenCha930511",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onView:opencodePanel.chatView",
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SenCha930511/opencode-panel.git"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "enabledApiProposals": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodePanel",
          "title": "OpenCode Panel",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencodePanel": [
        {
          "id": "opencodePanel.chatView",
          "name": "OpenCode Panel",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodePanel.toggleHistory",
        "title": "歷程記錄",
        "category": "OpenCode Panel",
        "icon": "$(history)"
      },
      {
        "command": "opencodePanel.newSession",
        "title": "新對話",
        "category": "OpenCode Panel",
        "icon": "$(add)"
      },
      {
        "command": "opencodePanel.openSettings",
        "title": "設定",
        "category": "OpenCode Panel",
        "icon": "$(gear)"
      },
      {
        "command": "opencodePanel.startServer",
        "title": "啟動伺服器",
        "category": "OpenCode Panel",
        "icon": "$(play)"
      },
      {
        "command": "opencodePanel.stopServer",
        "title": "停止伺服器",
        "category": "OpenCode Panel",
        "icon": "$(debug-stop)"
      },
      {
        "command": "opencodePanel.restartServer",
        "title": "重啟伺服器",
        "category": "OpenCode Panel",
        "icon": "$(debug-restart)"
      },
      {
        "command": "opencodePanel.openTui",
        "title": "開啟 TUI",
        "category": "OpenCode Panel",
        "icon": "$(terminal)"
      },
      {
        "command": "opencodePanel.attachSelection",
        "title": "附加選取內容",
        "category": "OpenCode Panel",
        "icon": "$(selection)"
      },
      {
        "command": "opencodePanel.attachFile",
        "title": "附加檔案",
        "category": "OpenCode Panel",
        "icon": "$(file)"
      },
      {
        "command": "opencodePanel.exportTranscript",
        "title": "匯出對話紀錄",
        "category": "OpenCode Panel",
        "icon": "$(export)"
      },
      {
        "command": "opencodePanel.openLogs",
        "title": "開啟記錄",
        "category": "OpenCode Panel",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodePanel.newSession",
          "when": "view == opencodePanel.chatView",
          "group": "navigation@1"
        },
        {
          "command": "opencodePanel.toggleHistory",
          "when": "view == opencodePanel.chatView",
          "group": "navigation@2"
        },
        {
          "command": "opencodePanel.openSettings",
          "when": "view == opencodePanel.chatView",
          "group": "navigation@3"
        },
        {
          "command": "opencodePanel.startServer",
          "when": "view == opencodePanel.chatView",
          "group": "1_server@1"
        },
        {
          "command": "opencodePanel.stopServer",
          "when": "view == opencodePanel.chatView",
          "group": "1_server@2"
        },
        {
          "command": "opencodePanel.restartServer",
          "when": "view == opencodePanel.chatView",
          "group": "1_server@3"
        },
        {
          "command": "opencodePanel.openTui",
          "when": "view == opencodePanel.chatView",
          "group": "1_server@4"
        }
      ],
      "editor/context": [
        {
          "command": "opencodePanel.attachSelection",
          "when": "editorHasSelection",
          "group": "opencodePanel@1"
        },
        {
          "command": "opencodePanel.attachFile",
          "group": "opencodePanel@2"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Panel",
      "properties": {
        "opencodePanel.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%opencodePanel.config.serverUrl.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.port": {
          "type": "number",
          "default": 4096,
          "markdownDescription": "%opencodePanel.config.port.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.hostname": {
          "type": "string",
          "default": "127.0.0.1",
          "markdownDescription": "%opencodePanel.config.hostname.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.binaryPath": {
          "type": "string",
          "default": "opencode",
          "markdownDescription": "%opencodePanel.config.binaryPath.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%opencodePanel.config.serverArgs.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.autoStartServer": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%opencodePanel.config.autoStartServer.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.minimumServerVersion": {
          "type": "string",
          "default": "0.0.0",
          "markdownDescription": "%opencodePanel.config.minimumServerVersion.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.debugLogs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%opencodePanel.config.debugLogs.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.chatFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "%opencodePanel.config.chatFontFamily.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.chatFontSize": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%opencodePanel.config.chatFontSize.markdownDescription%",
          "scope": "resource"
        },
        "opencodePanel.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-TW"
          ],
          "default": "auto",
          "markdownDescription": "%opencodePanel.config.language.markdownDescription%",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build && npm run build:webview",
    "build": "node esbuild.config.mjs --production",
    "build:webview": "vite build --mode production src/webview",
    "watch": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --watch --mode development src/webview",
    "package": "vsce package",
    "test": "node esbuild.config.mjs --test && node dist/test/runTest.js",
    "test:unit": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.18",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "1.99.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.12",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
